# KIS Developer API 설정 파일 예시
#
# 빠른 시작
# 1) 이 파일을 복사합니다.
#      cp trading/config/kis_devlp.yaml.example trading/config/kis_devlp.yaml
# 2) [필수] 표시가 있는 값만 먼저 입력합니다.
# 3) 이 예시는 실전 자동주문 기본값입니다. API 키·계좌·주문 금액을 모두 확인한 뒤 사용하세요.
# 4) 모의투자로 먼저 확인하려면 default_mode를 "demo", auto_trading을 false로 바꾸세요.
#
# 보안
# - kis_devlp.yaml에는 API 키와 계좌번호가 들어가므로 Git에 올리지 마세요.
# - 이 저장소는 해당 파일을 기본적으로 Git 추적에서 제외합니다.
# - Linux/macOS에서는 다음 권한을 권장합니다: chmod 600 trading/config/kis_devlp.yaml

# -----------------------------------------------------------------------------
# 1. 기본 실행값
# -----------------------------------------------------------------------------

# [필수] 기본 매매 환경: "demo"(모의투자) 또는 "real"(실전투자)
default_mode: "real"

# 주문 전송 스위치
# - false: 신호·연결·설정을 확인하지만 주문은 전송하지 않습니다.
# - true : KIS에 실제 주문 요청을 보냅니다. demo 모드에서도 주문 요청이 전송됩니다.
auto_trading: true

# 한 신호를 여러 계좌에 실행할지 선택합니다.
# - false: 시장별 primary 계좌 1개만 사용합니다. 처음에는 이 값을 유지하세요.
# - true : 조건이 맞고 enabled: true인 모든 계좌에 각각 주문을 시도합니다.
multi_account_trading:
  enabled: false

# -----------------------------------------------------------------------------
# 2. 1회 매수 금액 (전체 자산 비율 사용)
# -----------------------------------------------------------------------------

# 아래 고정 금액은 자산 조회에 실패했을 때 사용됩니다.
default_unit_amount: 1000000     # 국내 주식 1회 매수 금액 (KRW)
default_unit_amount_usd: 1000    # 미국 주식 1회 매수 금액 (USD)

# 전체 자산 비율로 주문하려면 0보다 크고 100 이하의 숫자를 입력합니다.
# 현재 값 10은 보유 주식 평가액과 현금을 합친 전체 자산의 10%입니다.
# 빈 문자열("")이면 위의 고정 금액을 사용합니다.
default_unit_asset_percent: 10
default_unit_asset_percent_usd: 10

# 미국 주식 매수 시 USD 예수금이 부족할 때 원화->USD 자동환전 가능 금액을 사용할지 선택합니다.
# true이면 자동환전을 사용하며, 아래 한도도 함께 확인하세요.
auto_exchange_usd_on_buy: true
auto_exchange_buffer_percent: 5.0
max_auto_exchange_krw: null          # 예: 500000; null이면 KIS가 계산한 가능 금액까지 사용
auto_exchange_min_shortfall_usd: 0.0 # 0이면 USD가 조금이라도 부족할 때 조회

# 일반 주식 계좌의 상품 코드는 보통 "01"입니다.
# 01: 종합계좌, 03: 국내선물옵션, 08: 해외선물옵션, 22: 개인연금, 29: 퇴직연금
default_product_code: "01"

# -----------------------------------------------------------------------------
# 3. KIS API 인증 정보
# -----------------------------------------------------------------------------

# [필수] 한국투자증권 HTS 로그인 ID
my_htsid: ""

# 모의투자를 쓸 때만 입력합니다. App Key는 보통 PSVT로 시작합니다.
paper_app: ""
paper_sec: ""

# [필수] 실전투자를 쓸 때 입력합니다. 실전 App Key는 PS로 시작하고 PSVT가 아닙니다.
my_app: ""
my_sec: ""

# -----------------------------------------------------------------------------
# 4. 계좌 설정
# -----------------------------------------------------------------------------

# [필수] 최소 한 개의 계좌를 입력합니다.
# 계좌번호가 12345678-01이면 account는 "12345678", product는 "01"입니다.
#
# 각 항목의 뜻
# - name    : 로그와 오류 메시지에 보이는 고유한 이름
# - enabled : false이면 이 계좌를 사용하지 않습니다.
# - mode    : "demo" 또는 "real"
# - market  : "kr"(국내), "us"(미국), "all"(국내+미국)
# - primary : 같은 mode·market 계좌가 여럿일 때 기본으로 쓸 계좌
accounts:
  - name: "실전-메인"
    enabled: true
    mode: "real"
    market: "all"
    account: "12345678"  # [필수] 계좌번호 앞 8자리로 변경
    product: "01"
    primary: true

    # 보통은 위의 paper_app/paper_sec 또는 my_app/my_sec을 자동으로 사용합니다.
    # 계좌마다 별도 App Key가 필요할 때만 아래 주석을 해제해 입력하세요.
    # app_key: ""
    # app_secret: ""

# 계좌를 추가할 때는 위 블록을 복사하고 name, mode, market, account를 바꾸세요.
# 자동 다계좌 주문에는 multi_account_trading.enabled: true가 추가로 필요합니다.
#
# 계좌별 주문 금액이 필요할 때만 계좌 블록에 아래 값을 추가합니다.
# 둘 중 하나만 지정하세요. buy_percent_*가 있으면 전체 자산 비율을 사용합니다.
#   buy_amount_krw: 50000
#   buy_amount_usd: 50
#   buy_percent_krw: 2.5
#   buy_percent_usd: 2.5
#   auto_exchange_usd_on_buy: true
#   max_auto_exchange_krw: 500000

# -----------------------------------------------------------------------------
# 5. 신호 전략 (선택)
# -----------------------------------------------------------------------------

# 기본값은 BUY/SELL 신호를 처리하는 "balanced_risk" 전략입니다.
# 이 예시는 프로젝트의 기본 동작을 사용하므로, 세부 옵션을 추가할 필요가 없습니다.
# 전략별 옵션과 동작은 trading/STRATEGIES.md를 확인하세요.
# 기존 기본 동작을 유지하려면 name을 빈 문자열("")로 바꾸세요.
signal_strategy:
  name: "balanced_risk"

# 자주 쓰는 안전 옵션 예시입니다. 필요할 때만 signal_strategy 안에 추가하세요.
#   require_stop_loss: true       # stop_loss가 없는 BUY 신호 거부
#   require_target_price: true    # target_price가 없는 BUY 신호 거부
#   min_score: 70                 # buy_score가 70 미만인 BUY 신호 거부
#   max_position_amount_krw: 300000
#   max_position_amount_usd: 300
#
# 신호 중복을 제한하려면 아래 예시를 사용합니다.
#   window_minutes: 30
#   apply_to_signal_types: ["BUY"]
#   scope: "market_ticker"
#
# 신호의 target_price와 stop_loss만으로 매도 조건을 제한하려면:
#   name: "bracket_exit"
#   target_sell_percent: 0.50
#   stop_loss_sell_percent: 1.0
#
# 외부 시세 조회 없이 수신 신호 가격으로만 trailing stop을 관리하려면:
#   name: "signal_trailing_stop"
#   trail_percent: 8.0
#   sell_fraction: 1.0
#   require_tracked_entry: true
#
# 높은 위험을 수용하고, 모든 유효 BUY/SELL 신호를 실행하며 점수별 비율로
# 가용 현금과 보유 수량을 배분하려면:
#   name: "score_max_capital"
#   buy_score_bands: {0: 0.60, 6: 0.85, 8: 1.00}
#   sell_score_bands: {0: 0.25, 6: 0.60, 8: 1.00}
#   missing_buy_score_ratio: 1.00
#   missing_sell_score_ratio: 1.00
# 비율은 반드시 0보다 크고 1 이하여야 합니다. 이 전략은 별도의 손절,
# 포지션 한도, 보상-위험 또는 위험회피 필터를 적용하지 않습니다.

# -----------------------------------------------------------------------------
# 6. 실시간 손절가 감시 (Stop-loss Watcher)
# -----------------------------------------------------------------------------
# BUY 신호에 포함된 stop_loss를 자동 등록하고, 정규 장중 실시간 시세를 감시하여
# 외부 SELL 신호 없이도 손절가 도달 시 자동으로 전량 손절 매도(SELL)를 실행합니다.
# KIS API 초당 호출 제한(Rate Limit)을 보호하기 위해 종목 간 안전 지연(0.2초)을 둡니다.
stop_loss_watcher:
  enabled: true                 # true: 자동 손절 감시 활성화 (기본값: false)
  poll_seconds: 5.0             # 감시 주기(초, 기본값: 5.0)
  request_interval_seconds: 0.2 # 종목별 시세 조회 간격(초, Rate Limit 방어용, 기본값: 0.2)

# -----------------------------------------------------------------------------
# 7. KIS 연결 정보 (보통 수정하지 않음)
# -----------------------------------------------------------------------------

# User-Agent는 기본값을 그대로 사용하세요.
my_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36"

# 토큰 캐시 값입니다. 처음 설정할 때는 빈 문자열로 두세요.
my_token: ""

# KIS API·웹소켓 주소입니다. 수정하지 마세요.
prod: "https://openapi.koreainvestment.com:9443"
ops: "ws://ops.koreainvestment.com:21000"
vps: "https://openapivts.koreainvestment.com:29443"
vops: "ws://ops.koreainvestment.com:31000"

