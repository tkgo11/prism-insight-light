GCP_PROJECT_ID=your-project-id
GCP_PUBSUB_SUBSCRIPTION_ID=your-subscription-id
GCP_CREDENTIALS_PATH=/absolute/path/to/service-account.json
TELEGRAM_SIGNAL_CHANNEL_URL=https://t.me/prism_insight_global_en
TELEGRAM_FETCH_PAGES=3
# Retry KIS API rate-limit responses (EGW00201) with exponential backoff.
KIS_RATE_LIMIT_RETRY_ATTEMPTS=10
KIS_RATE_LIMIT_RETRY_BASE_SECONDS=1.0
KIS_RATE_LIMIT_RETRY_MAX_SECONDS=5.0
# Bound connect/read waits so timed-out broker calls do not run indefinitely.
KIS_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
KIS_HTTP_READ_TIMEOUT_SECONDS=30.0
# Allow accepted Pub/Sub or queued broker work to finish after intake is cancelled.
SUBSCRIBER_SHUTDOWN_DRAIN_SECONDS=180
# Bound Pub/Sub callback admission; all in-process broker workflows are serialized separately.
PUBSUB_MAX_IN_FLIGHT_MESSAGES=1
# Optional explicit KIS YAML path. Useful for read-only deployments and isolated tests.
PRISM_KIS_CONFIG_PATH=
# Optional directory for local runtime state (order queue, dedupe ledger, locks).
# Defaults to runtime/ under the working directory.
PRISM_RUNTIME_DIR=
# When true, persisted KIS token filenames get a random per-process suffix.
# Caution: each process writes its own token file, defeating the shared
# single-flight token reuse across processes — leave false for multi-process
# deployments.
KIS_SECURE_TOKEN=false
# Subscriber logging: Python logging level and optional raw Pub/Sub payload log.
LOG_LEVEL=INFO
RAW_PUBSUB_LOG_FILE=

# Receiver-side signal safety gate. The upstream Pub/Sub publisher is not
# trusted blindly: signals can arrive stale, duplicated, or carrying a price
# that has moved. All checks are progressive — missing metadata falls back
# safely instead of rejecting valid legacy payloads.
# Master kill switch for the whole gate (reverts to legacy pass-through).
SIGNAL_SAFETY_ENABLED=true
# Maximum signal age before a live (non-queued) order is refused.
SIGNAL_MAX_AGE_BUY_SECONDS=900
SIGNAL_MAX_AGE_SELL_SECONDS=900
SIGNAL_MAX_AGE_EVENT_SECONDS=21600
# Maximum total age for a signal executed from the off-hours queue
# (default 4 days so weekend-closure signals survive to the next open).
SIGNAL_QUEUED_MAX_AGE_SECONDS=345600
# When true, trade signals WITHOUT any usable timestamp are rejected
# (default false for backward compatibility with the existing publisher).
SIGNAL_STRICT_TIMESTAMP=false
# How far a signal timestamp may sit in the future before it is rejected
# (covers publisher/receiver clock skew).
SIGNAL_MAX_FUTURE_SKEW_SECONDS=300
# Fresh KIS quote revalidation immediately before a live order is submitted.
# A quote lookup failure defers execution (nothing was submitted); a quote
# outside the deviation band rejects the signal permanently.
SIGNAL_FRESH_QUOTE_ENABLED=true
SIGNAL_QUOTE_CACHE_SECONDS=5
SIGNAL_PRICE_DEVIATION_BUY=0.10
SIGNAL_PRICE_DEVIATION_SELL=0.10
# Bounded JSONL audit trail for rejected/suppressed signals.
SIGNAL_AUDIT_ENABLED=true
# Defaults to runtime/signal_rejections.jsonl or $PRISM_RUNTIME_DIR.
SIGNAL_AUDIT_PATH=
SIGNAL_AUDIT_MAX_ENTRIES=1000

# Local WebUI defaults. Non-loopback binding requires explicit opt-in and is read-only.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8765
WEBUI_ALLOW_NON_LOOPBACK=false
WEBUI_ALLOWED_HOSTS=
WEBUI_FORCE_DRY_RUN=false
WEBUI_QUEUE_PATH=runtime/off_hours_queue.json
# Managed read-only container mounts set this automatically.
WEBUI_CONFIG_READ_ONLY=false
# Keep live broker calls locked unless a trusted local operator explicitly arms them.
WEBUI_ENABLE_LIVE_TRADING=false
# Blank generates a fresh token on each process start. Set a long random value for API clients.
WEBUI_CSRF_TOKEN=
